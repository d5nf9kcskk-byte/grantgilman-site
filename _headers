# Cloudflare Pages headers — replaces the Apache mod_expires cache rules.
# Keep favicons short-lived so a new icon shows up without a hard cache wipe.
/favicon.v3.ico
  Cache-Control: public, max-age=3600, must-revalidate
/favicon-32.v3.png
  Cache-Control: public, max-age=3600, must-revalidate
/favicon-512.v3.png
  Cache-Control: public, max-age=3600, must-revalidate
/apple-touch-icon.v3.png
  Cache-Control: public, max-age=3600, must-revalidate

# Long-cache the heavy static assets (fonts, images, css, js).
/assets/*
  Cache-Control: public, max-age=2592000
